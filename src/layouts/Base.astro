---
import '../styles/styles.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The page's address, such as "/south-goa/salcete/". */
  path: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E8B23A" />
    <meta name="color-scheme" content="light dark" />
    <!-- Marks the page as having JavaScript, and sets the dark theme from the phone or computer setting. Runs before paint so the page never flashes light. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var q = window.matchMedia('(prefers-color-scheme: dark)');
        var set = function () {
          if (q.matches) document.documentElement.setAttribute('data-theme', 'dark');
          else document.documentElement.removeAttribute('data-theme');
        };
        set();
        q.addEventListener('change', set);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
