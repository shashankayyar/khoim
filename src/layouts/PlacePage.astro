---
/* One page per place, and the home page. The plain HTML below is what loads first, what search engines read
   and what works without JavaScript: the place's names, how to say it, where the names come from, and links
   to the places inside it. The map app then takes over the screen, opened at the same place. */
import Base from './Base.astro';
import KhoimApp from '../app/KhoimApp';
import { Credit } from '../components/core/Credit';
import { DraftBanner } from '../components/core/DraftBanner';
import { Wordmark } from '../components/core/Wordmark';
import { PlaceCard } from '../components/place/PlaceCard';
import { PAGE_INDEX } from '../data/pageIndex';
import villagesJson from '../data/generated/villages.json';
import factsJson from '../data/generated/village-facts.json';
import { allVillagesOf, childrenOf, factsOf, getPlace, houseOf, pathOf, registerVillageFacts, registerVillages, trailOf } from '../data/khoim';
import { jsonLdText, structuredData } from '../data/jsonld';
import { ogImagePath, pageMeta } from '../data/seo';
import type { RawVillage, VillageFacts } from '../data/types';
import { tellUsWhatIsWrongHref } from '../lib/mailto';
import '../styles/static.css';
import VillageTable from '../components/static/VillageTable.astro';

interface Props {
  /** Missing = all of Goa (the home page). */
  placeId?: string;
  /** The page shown for an address that does not exist. It opens the map on all of Goa. */
  notFound?: boolean;
  /** A taluka's village list (/north-goa/bardez/villages/). The same content as the taluka's page, so it is kept
      out of search results and points to the taluka's page as the one to show. */
  list?: boolean;
}

const { placeId, notFound = false, list = false } = Astro.props;
const raw = villagesJson as unknown as RawVillage[];
registerVillages(raw);
registerVillageFacts(factsJson as unknown as Record<string, VillageFacts>);

const place = getPlace(placeId ?? 'goa')!;
const home = place.level === 'state';
const meta = pageMeta(place);
/* TODO(copy): the list's title, from the design's "Villages in {taluka}" */
const title = list ? `Villages in ${place.official} | Khoim` : meta.title;
/* Village pages without a reviewed name or two sourced facts stay out of search results (scripts/pages.mjs). */
const indexable = PAGE_INDEX.places[place.id]?.index ?? false;
const jsonLd = notFound ? undefined : jsonLdText(structuredData(place, PAGE_INDEX, Astro.site!));
/* What the preview image shows, for people who cannot see it: the names on file, then the official name. */
const ogImageAlt = [place.deva, place.romi, place.official].filter(Boolean).join(', ') + '. Khoim, khoim.in';
const path = pathOf(place);
const pageUrl = new URL(path, Astro.site).href;
const trail = trailOf(place.id);
/* A taluka lists its villages as a table; Kushavati lists its talukas and then all their villages (phase 2, A5). */
const inside = place.level === 'taluka' || place.level === 'village' ? [] : childrenOf(place.id);
const tableOf = place.level === 'taluka' ? allVillagesOf(place.id)
  : place.id === 'kushavati' ? childrenOf(place.id).flatMap(t => allVillagesOf(t.id)) : [];
const initialVillage = place.level === 'village' ? raw.find(v => v.id === place.id) : undefined;
---

<Base title={title} description={meta.description} path={path} noindex={notFound || list || !indexable} ogImage={ogImagePath(place)} ogImageAlt={ogImageAlt} jsonLd={jsonLd}>
  <div id="khoim-static" class:list={['static', home ? 'static--home' : 'static--place']}>
    <div class="static__banner"><DraftBanner tellUsHref={tellUsWhatIsWrongHref(pageUrl)} /></div>
    <div class="static__body">
      <div class="static__map">
        <header class="static__head">
          <a class="static__wordmark" href="/"><Wordmark size={22} /></a>
          {!home && (
            <nav class="k-crumbs static__crumbs" aria-label="Where you are">
              {trail.map((t, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a class="k-crumbs__link" href={pathOf(t)} aria-current={i === trail.length - 1 ? 'page' : undefined}>{t.official}</a>
                </>
              ))}
            </nav>
          )}
        </header>
        {home && <h1 class="static__title">Every taluka in Goa, with its Konkani name and how to say it.</h1>}
      </div>
      <div class="static__panel">
        <div class="static__panel-body">
          {!home && (
            <div class="static__card" data-house={houseOf(place).key} style={`--peek:${place.deva ? 318 : 344}px`}>
              <PlaceCard place={place} expanded plain headingLevel={1} facts={factsOf(place.id)} />
            </div>
          )}
          {inside.length > 0 && (
            <nav class="static__places" aria-label={'Places in ' + place.official}>
              <ul>
                {inside.map(c => (
                  <li>
                    <a href={pathOf(c)}>
                      {c.deva && <span class="static__deva" lang="gom">{c.deva}</span>}
                      {c.romi && <span lang="gom-Latn">{c.romi}</span>}
                      <span>{c.official}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {tableOf.length > 0 && <VillageTable villages={tableOf} place={place} />}
        </div>
        <footer class="static__footer"><Credit /></footer>
      </div>
    </div>
  </div>
  <KhoimApp client:only="react" initialId={home ? undefined : place.id} initialVillage={initialVillage} initialList={list} />
</Base>
