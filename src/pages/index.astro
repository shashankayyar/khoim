---
/* Home: all of Goa. The plain page below is what loads first and what works without JavaScript;
   the map app then takes over the screen. */
import Base from '../layouts/Base.astro';
import KhoimApp from '../app/KhoimApp';
import { DraftBanner } from '../components/core/DraftBanner';
import { Wordmark } from '../components/core/Wordmark';
import { Button } from '../components/core/Button';
import { Credit } from '../components/core/Credit';
import { tellUsWhatIsWrongHref, writeToUsHref } from '../lib/mailto';

// SEO text from docs/copy.md
const title = "Khoim | Goa's place names in Konkani, and how to say them";
const description = "A map of Goa's districts, talukas and villages. Official spellings next to Konkani names in Devanagari and Romi, with a guide to saying each one.";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base title={title} description={description}>
  <div id="khoim-static" class="static">
    <div class="static__banner"><DraftBanner tellUsHref={tellUsWhatIsWrongHref(pageUrl)} /></div>
    <main class="static__main">
      <div class="static__wordmark"><Wordmark size={22} /></div>
      <h1 class="static__title">Every taluka in Goa, with its Konkani name and how to say it.</h1>
      <noscript>
        <div class="static__action">
          <Button icon="mail" href={writeToUsHref()}>Write to us</Button>
        </div>
      </noscript>
    </main>
    <footer class="static__footer">
      <Credit />
    </footer>
  </div>
  <KhoimApp client:only="react" />
</Base>

<style>
  /* Sized and placed like the app's first screen, so nothing jumps when the map takes over. */
  .static {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .static__banner {
    display: none;
  }
  .static__main {
    padding: 14px 16px 0;
  }
  .static__wordmark {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 6px;
  }
  .static__title {
    margin: 14px 20px 0 4px;
    font: var(--weight-strong) var(--size-title)/var(--lh-title) var(--font-latin);
    letter-spacing: var(--track-title);
    text-wrap: pretty;
  }
  .static__action {
    margin: var(--space-8) 4px 0;
  }
  .static__footer {
    padding: var(--space-6) var(--gutter) var(--space-10);
  }
  @media (min-width: 1180px) {
    .static__banner {
      display: block;
    }
    .static__main {
      padding: 20px 28px 0;
    }
    .static__wordmark {
      padding: 0 4px;
    }
    .static__wordmark :global(.k-wordmark) {
      --wordmark-size: 26px !important;
    }
    .static__title {
      margin: 42px 0 0 4px;
      width: 330px;
      font-size: 40px;
      line-height: 1.1;
    }
    .static__footer {
      padding: 14px 24px 18px;
    }
  }
</style>
