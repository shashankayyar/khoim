---
/* Placeholder home for the first deploy. The map app replaces this in phase 1. */
import Base from '../layouts/Base.astro';
import { DraftBanner } from '../components/core/DraftBanner';
import { Wordmark } from '../components/core/Wordmark';
import { Button } from '../components/core/Button';
import { Credit } from '../components/core/Credit';
import { tellUsWhatIsWrongHref, writeToUsHref } from '../lib/mailto';

// SEO text from docs/copy.md
const title = "Khoim | Goa's place names in Konkani, and how to say them";
const description = "A map of Goa's districts, talukas and villages. Official spellings next to Konkani names in Devanagari and Romi, with a guide to saying each one.";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base title={title} description={description}>
  <div class="home">
    <DraftBanner tellUsHref={tellUsWhatIsWrongHref(pageUrl)} />
    <main class="home__main">
      <Wordmark size={40} />
      <h1 class="home__title">Every taluka in Goa, with its Konkani name and how to say it.</h1>
      <div class="home__action">
        <Button icon="mail" href={writeToUsHref()}>Write to us</Button>
      </div>
    </main>
    <footer class="home__footer">
      <Credit />
    </footer>
  </div>
</Base>

<style>
  .home {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .home__main,
  .home__footer {
    box-sizing: border-box;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 16px var(--gutter);
  }
  .home__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .home__title {
    margin: var(--space-12) 0 0;
    max-width: 22ch;
    font: var(--weight-strong) var(--size-title)/var(--lh-title) var(--font-latin);
    letter-spacing: var(--track-title);
    text-wrap: balance;
  }
  .home__action {
    margin-top: var(--space-8);
  }
  .home__footer {
    padding-bottom: var(--space-10);
  }
  .home__footer > :global(*) {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .home__main {
      padding-top: var(--space-6);
    }
    .home__title {
      margin-top: var(--space-16);
      font-size: 40px;
      line-height: 1.1;
    }
  }
</style>
