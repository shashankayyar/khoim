---
/* What the names mean, A to Z (phase 4, B5). Every village with an origin on its sheet, from
   data/credited/origins_luis_2026.csv through the village facts: our summary, the source's own hedge, the credit and
   its link (phase 2 rule 2). Each entry links to its village. Wording approved on 19 October 2026 (docs/copy.md, Phase 4). */
import DocPage from '../layouts/DocPage.astro';
import DocEntry from '../components/static/DocEntry.astro';
import villagesJson from '../data/generated/villages.json';
import factsJson from '../data/generated/village-facts.json';
import { getPlace, pathOf, registerVillages } from '../data/khoim';
import type { Place, RawVillage, VillageFacts } from '../data/types';

registerVillages(villagesJson as unknown as RawVillage[]);
const entries = Object.entries(factsJson as unknown as Record<string, VillageFacts>)
  .filter(([, f]) => f.meaning?.readings.length)
  .map(([id, f]) => ({ p: getPlace(id) as Place, m: f.meaning! }))
  .filter(e => e.p)
  .sort((a, b) => a.p.official.localeCompare(b.p.official));
const letters = [...new Set(entries.map(e => e.p.official[0].toUpperCase()))];
---

<DocPage title="What Goa's village names mean, A to Z | Khoim" description="Where Goa's village names come from, village by village, each reading with its source and how sure the source is." path="/meanings/">
      <h1>What the names mean, A to Z</h1>
      <p>{entries.length} villages with an origin on file, in our words, each with its source and the source's own caution. Where sources differ, both are given.</p>
      <ul class="doc-jump">{letters.map(l => <li><a href={'#' + l}>{l}</a></li>)}</ul>
      {letters.map(l => (
        <section id={l}>
          <h2>{l}</h2>
          <ul class="doc-entries">
            {entries.filter(e => e.p.official[0].toUpperCase() === l).map(e => (
              <DocEntry name={e.p.official} nameHref={pathOf(e.p)} after={`${getPlace(e.p.parent)?.official}.`}>
                {e.m.readings.map(r => (
                  <>
                    <span class="doc-entry__text">{r.text}{r.hedge ? ` (${r.hedge})` : ''}.</span>
                    <span class="doc-entry__source">{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.credit}</a> : r.credit}</span>
                  </>
                ))}
                {e.m.differ && <span class="doc-entry__source">Sources differ.</span>}
              </DocEntry>
            ))}
          </ul>
        </section>
      ))}
      <p><a href="/feasts/">Feasts and zatras, by month</a></p>
    </DocPage>
