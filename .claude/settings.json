{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm install *)", "Bash(npm ci)", "Bash(npm run *)", "Bash(npm view *)", "Bash(npx astro *)",
      "Bash(git status)", "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git switch *)", "Bash(git checkout -b *)", "Bash(git fetch *)", "Bash(git pull *)",
      "Bash(git push)", "Bash(git push -u origin *)",
      "Bash(gh pr create *)", "Bash(gh pr view *)", "Bash(gh pr list *)", "Bash(gh pr checks *)", "Bash(gh pr comment *)", "Bash(gh repo view *)",
      "WebFetch(domain:docs.astro.build)", "WebFetch(domain:developers.cloudflare.com)"
    ],
    "ask": [
      "Bash(gh pr merge *)", "Bash(gh repo create *)", "Bash(gh api *)", "Bash(npm uninstall *)",
      "Bash(rm *)", "Bash(git reset *)", "Bash(git rebase *)",
      "Edit(./.github/workflows/**)", "Edit(./.claude/settings.json)", "Edit(./wrangler.jsonc)"
    ],
    "deny": [
      "Bash(git push * main)", "Bash(git push *:main*)", "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * --force*)",
      "Bash(npx wrangler deploy*)", "Bash(wrangler deploy*)", "Bash(npx wrangler login*)",
      "Bash(sudo *)", "Bash(curl *)", "Bash(wget *)",
      "Bash(gh auth token*)", "Bash(gh secret *)", "Bash(gh repo delete *)", "Bash(gh repo edit *)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gh/**)", "Read(~/Library/Preferences/.wrangler/**)", "Read(~/.npmrc)",
      "Read(./.env)", "Read(./.env.*)", "Read(./.dev.vars*)"
    ]
  }
}
