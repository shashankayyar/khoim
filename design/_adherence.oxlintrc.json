{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/layers/**",
              "components/map/**",
              "components/nav/**",
              "components/place/**",
              "components/search/**",
              "components/share/**",
              "components/village/**",
              "ui_kits/khoim/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anek Devanagari|Anek Latin))/i]",
        "message": "Font not provided by the design system. Available: Anek Devanagari, Anek Latin."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|script|onNavigate|tone|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: id, script, onNavigate, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute[name.name='script'] > Literal[value!=/^(?:official|deva|romi)$/]",
        "message": "<Breadcrumb> script must be one of 'official' | 'deva' | 'romi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:raised|plain)$/]",
        "message": "<Breadcrumb> tone must be one of 'raised' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|ink|paper|icon|iconAfter|full|disabled|onClick|children|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, ink, paper, icon, iconAfter, full, disabled, onClick, children, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|m)$/]",
        "message": "<Button> size must be one of 'l' | 'm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Credit'] > JSXAttribute > JSXIdentifier[name!=/^(?:full|style|key|ref|className|style|children)$/]",
        "message": "<Credit> doesn't accept that prop. Declared props: full, style."
      },
