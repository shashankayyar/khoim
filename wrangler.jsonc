{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khoim",
  "compatibility_date": "2026-09-29",

  // The small server part (worker/). It runs only for /api/ addresses: the contribution form, the admin page's
  // data and the queue. Every page, the map and the fonts are plain files in dist/, served without it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // The queue of contributions. Cloudflare creates this database the first time this is deployed.
  "d1_databases": [{ "binding": "DB", "database_name": "khoim-contributions" }],

  // Everything else the server part needs is set in Cloudflare's dashboard (Worker, Settings, Variables and
  // Secrets), never here: TURNSTILE_SITE_KEY, TURNSTILE_SECRET, QUEUE_KEY, ACCESS_TEAM, ACCESS_AUD, REVIEWERS.
  // Until they are set, the form stays switched off and the cards keep their email buttons.
  // See docs/contributions-setup.md.

  "preview_urls": true,

  // Pull request previews ("npx wrangler preview") do not share anything with the live site. They get their
  // own database, and Cloudflare's published test keys for the bot check, which always pass. These two keys
  // are test values, not secrets. The admin page does not work on previews: there is no login in front of them.
  "previews": {
    "d1_databases": [{ "binding": "DB", "database_name": "khoim-contributions-preview" }],
    "vars": {
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
    }
  }
}
